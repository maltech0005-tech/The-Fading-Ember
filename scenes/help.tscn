[node name="main_label" type="RichTextLabel" parent="."]
offset_left = 95.0
offset_top = 36.0
offset_right = 449.0
offset_bottom = 262.0
theme_override_font_sizes/normal_font_size = 28
theme_override_font_sizes/bold_font_size = 28
